# Pump Quant Bot — Environment Variables
# Copy to .env and fill in real values

# === Wallet ===
WALLET_PRIVATE_KEY=           # Base58-encoded Solana private key (NEVER commit this)
WALLET_PUBLIC_KEY=            # Base58-encoded Solana public key

# === API Keys ===
PUMP_PORTAL_API_KEY=          # PumpPortal websocket/API key
BITQUERY_API_KEY=             # Bitquery API key for enrichment queries

# === Solana RPC ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com

# === PumpPortal ===
PUMP_PORTAL_WS_URL=wss://pumpportal.fun/api/data
PUMP_PORTAL_API_URL=https://pumpportal.fun/api

# === Bitquery ===
BITQUERY_API_KEY=             # Bitquery API key (used for both GraphQL and CoreCast)
BITQUERY_API_URL=https://streaming.bitquery.io/graphql

# === CoreCast (Primary Fast-Lane) ===
# CoreCast uses the same BITQUERY_API_KEY by default
# Enable in config/default.json: corecast.enabled = true

# === Jito (MEV-Protected Routes) ===
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_AUTH_KEY=                # Jito authentication key (if required)

# === Daemon HTTP API ===
DAEMON_HOST=127.0.0.1
DAEMON_PORT=9420

# === Mode ===
PAPER_MODE=false              # true = paper trading (synthetic fills)
LOG_LEVEL=info                # debug | info | warn | error

# === Config ===
CONFIG_PATH=config/default.json
DB_PATH=data/pump-quant.db

# === OpenClaw ===
OPENCLAW_PLUGIN_PORT=9421

    "express": "^4.21.1",
    "node-fetch": "^2.7.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/node-fetch": "^2.6.12",
    "@types/uuid": "^10.0.0",

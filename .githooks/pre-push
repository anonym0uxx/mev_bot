#!/bin/sh
# pre-push credential guard v2.
# Scans BOTH new-commit diffs (git show) AND the tree at the tip.
# Bypass is deliberate and loud: PQ_ALLOW_SECRET=1 git push
if [ "$PQ_ALLOW_SECRET" = "1" ]; then
  echo "pre-push: guard BYPASSED by PQ_ALLOW_SECRET=1" >&2
  exit 0
fi
UUID='[0-9a-fA-F]\{8\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{4\}-[0-9a-fA-F]\{12\}'
TG='[0-9]\{8,10\}:[A-Za-z0-9_-]\{30,40\}'
APIK='api[-_]\{0,1\}key[=:][A-Za-z0-9-]\{16,\}'
BENIGN='258EAFA5-E914-47DA-95CA-C5AB0DC85B11\|258eafa5-e914-47da-95ca-c5ab0dc85b11\|00000000-0000'
ZERO=0000000000000000000000000000000000000000
fail=0

while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "$remote_sha" = "$ZERO" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi

  for c in $commits; do
    hits=$(git show --format= --no-color "$c" | grep '^+' \
           | grep -e "$UUID" -e "$TG" -e "$APIK" | grep -v "$BENIGN")
    if [ -n "$hits" ]; then
      echo "pre-push: BLOCKED - credential in commit $c ($local_ref)" >&2
      fail=1
    fi
  done

  hits=$(git grep -I -e "$UUID" -e "$TG" -e "$APIK" "$local_sha" \
         2>/dev/null | grep -v "$BENIGN")
  if [ -n "$hits" ]; then
    echo "pre-push: BLOCKED - credential in tree at $local_sha" >&2
    fail=1
  fi
done

[ "$fail" = "1" ] && exit 1
exit 0

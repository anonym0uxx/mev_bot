{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pump-quant-config",
  "title": "Pump Quant Bot Configuration",
  "type": "object",
  "required": [
    "regime",
    "manipulation",
    "friction",
    "entry",
    "exit",
    "risk",
    "execution",
    "fees",
    "llm",
    "corecast",
    "features",
    "learning",
    "health"
  ],
  "additionalProperties": false,
  "properties": {
    "regime": {
      "type": "object",
      "required": [
        "early_curve_max_progress",
        "mid_curve_max_progress",
        "late_curve_max_progress",
        "graduation_boundary_start",
        "graduation_boundary_end",
        "max_token_age_s",
        "exclude_mayhem",
        "exclude_tokenized_agent"
      ],
      "additionalProperties": false,
      "properties": {
        "early_curve_max_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bonding curve progress upper bound for EARLY_CURVE"
        },
        "mid_curve_max_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bonding curve progress upper bound for MID_CURVE"
        },
        "late_curve_max_progress": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bonding curve progress upper bound for LATE_CURVE"
        },
        "graduation_boundary_start": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bonding curve progress start for graduation boundary"
        },
        "graduation_boundary_end": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Bonding curve progress end for graduation boundary"
        },
        "max_token_age_s": {
          "type": "number",
          "minimum": 0,
          "description": "Max token age in seconds to consider"
        },
        "exclude_mayhem": {
          "type": "boolean"
        },
        "exclude_tokenized_agent": {
          "type": "boolean"
        }
      }
    },
    "manipulation": {
      "type": "object",
      "required": [
        "hard_threshold",
        "creator_sell_instant_exit",
        "same_size_print_min_count",
        "same_size_print_window_s",
        "price_breadth_divergence_threshold",
        "concentration_worsening_threshold",
        "cluster_correlation_threshold",
        "suspicious_burst_threshold",
        "slippage_shock_threshold",
        "continuous_penalty_weights"
      ],
      "additionalProperties": false,
      "properties": {
        "hard_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Manipulation risk above this triggers hard rejection"
        },
        "creator_sell_instant_exit": {
          "type": "boolean"
        },
        "same_size_print_min_count": {
          "type": "integer",
          "minimum": 2
        },
        "same_size_print_window_s": {
          "type": "number",
          "minimum": 0
        },
        "same_size_tolerance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.02
        },
        "price_breadth_divergence_threshold": {
          "type": "number",
          "minimum": 0
        },
        "concentration_worsening_threshold": {
          "type": "number",
          "minimum": 0
        },
        "cluster_correlation_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "suspicious_burst_threshold": {
          "type": "number",
          "minimum": 0
        },
        "slippage_shock_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "continuous_penalty_weights": {
          "type": "object",
          "required": [
            "creator_sell",
            "same_size_prints",
            "price_breadth_divergence",
            "concentration_worsening",
            "cluster_correlation",
            "suspicious_burst",
            "slippage_shock"
          ],
          "additionalProperties": false,
          "properties": {
            "creator_sell": {
              "type": "number"
            },
            "same_size_prints": {
              "type": "number"
            },
            "price_breadth_divergence": {
              "type": "number"
            },
            "concentration_worsening": {
              "type": "number"
            },
            "cluster_correlation": {
              "type": "number"
            },
            "suspicious_burst": {
              "type": "number"
            },
            "slippage_shock": {
              "type": "number"
            }
          }
        }
      }
    },
    "friction": {
      "type": "object",
      "required": [
        "stale_threshold_s",
        "safety_buffer_pct",
        "slippage_estimation_method"
      ],
      "additionalProperties": false,
      "properties": {
        "stale_threshold_s": {
          "type": "number",
          "minimum": 0,
          "description": "Seconds before friction estimates are considered stale"
        },
        "safety_buffer_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Additional safety buffer for effective stop"
        },
        "slippage_estimation_method": {
          "type": "string",
          "enum": [
            "empirical",
            "model",
            "hybrid"
          ]
        },
        "default_entry_slippage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "default_exit_slippage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "landing_degradation_local_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "landing_degradation_lightning_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "min_entry_edge",
        "observation_window_s",
        "min_breadth_for_entry",
        "min_unique_buyers",
        "max_concentration_top10",
        "max_slippage_pct",
        "probability_weights",
        "calibration"
      ],
      "additionalProperties": true,
      "properties": {
        "min_entry_edge": {
          "type": "number",
          "minimum": 0,
          "description": "Minimum EntryEdge required for entry"
        },
        "observation_window_s": {
          "type": "number",
          "minimum": 0,
          "description": "Default observation window before entry consideration"
        },
        "min_breadth_for_entry": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Min breadth score for entry"
        },
        "min_unique_buyers": {
          "type": "integer",
          "minimum": 0
        },
        "max_concentration_top10": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Max top-10 concentration for entry"
        },
        "max_slippage_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ev_wait_horizon_s": {
          "type": "number",
          "minimum": 0,
          "default": 5
        },
        "ev_enter_horizon_s": {
          "type": "number",
          "minimum": 0,
          "default": 5
        },
        "probability_weights": {
          "type": "object",
          "required": [
            "bonding_curve_dynamics",
            "flow_momentum",
            "breadth_topology",
            "creator_wallet_prior",
            "friction_execution",
            "manipulation_distribution",
            "multimodal_junk"
          ],
          "additionalProperties": false,
          "properties": {
            "bonding_curve_dynamics": {
              "type": "number"
            },
            "flow_momentum": {
              "type": "number"
            },
            "breadth_topology": {
              "type": "number"
            },
            "creator_wallet_prior": {
              "type": "number"
            },
            "friction_execution": {
              "type": "number"
            },
            "manipulation_distribution": {
              "type": "number"
            },
            "multimodal_junk": {
              "type": "number"
            }
          }
        },
        "calibration": {
          "type": "object",
          "required": [
            "continuation_bias",
            "reversal_bias",
            "manipulation_bias"
          ],
          "additionalProperties": false,
          "properties": {
            "continuation_bias": {
              "type": "number"
            },
            "reversal_bias": {
              "type": "number"
            },
            "manipulation_bias": {
              "type": "number"
            }
          }
        },
        "min_p_continuation": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_trades_for_analysis": {
          "type": "number",
          "minimum": 1
        },
        "min_creator_prior": {
          "type": [
            "number",
            "null"
          ],
          "description": "Minimum creator prior. null = disabled"
        },
        "doa_velocity_decay_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "doa_min_new_buyers_3s": {
          "type": "integer",
          "minimum": 0
        },
        "min_flow_momentum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_breadth_topology": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "exit": {
      "type": "object",
      "required": [
        "hold_horizon_s",
        "retrace_threshold_base",
        "retrace_tightening_boundary",
        "retrace_tightening_slippage",
        "retrace_tightening_hold_edge",
        "retrace_tightening_time",
        "time_decay_start_s",
        "time_decay_pressure_per_s",
        "max_hold_time_s"
      ],
      "additionalProperties": true,
      "properties": {
        "hold_horizon_s": {
          "type": "number",
          "minimum": 0
        },
        "retrace_threshold_base": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retrace_tightening_boundary": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retrace_tightening_slippage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retrace_tightening_hold_edge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "retrace_tightening_time": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time_decay_start_s": {
          "type": "number",
          "minimum": 0
        },
        "time_decay_pressure_per_s": {
          "type": "number",
          "minimum": 0
        },
        "max_hold_time_s": {
          "type": "number",
          "minimum": 0
        },
        "take_profit_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "trailing_stop_activation_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "trailing_stop_distance_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier1_profit_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tier1_reduce_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "momentum_reversal_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "momentum_reversal_min_mfe_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "time_decay_exit_s": {
          "type": "number",
          "minimum": 0,
          "description": "Soft exit: if PnL flat/negative at this hold time, exit immediately. 0=disabled."
        },
        "velocity_exit_enabled": {
          "type": "boolean",
          "description": "Enable velocity evaporation exit"
        },
        "velocity_exit_min_hold_s": {
          "type": "number",
          "minimum": 0,
          "description": "Min hold before velocity exit"
        },
        "velocity_exit_zero_threshold": {
          "type": "number",
          "minimum": 0,
          "description": "Velocity threshold for exit"
        }
      }
    },
    "risk": {
      "type": "object",
      "required": [
        "bankroll_sol",
        "risk_per_trade_pct",
        "max_alloc_pct",
        "max_positions",
        "quick_spend_sol",
        "raw_stop_pct",
        "liquidity_cap_sol",
        "slippage_cap_sol",
        "max_daily_loss_sol"
      ],
      "additionalProperties": true,
      "properties": {
        "bankroll_sol": {
          "type": "number",
          "minimum": 0
        },
        "risk_per_trade_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_alloc_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_positions": {
          "type": "integer",
          "minimum": 1
        },
        "quick_spend_sol": {
          "type": "number",
          "minimum": 0,
          "description": "Operator-controlled default per-coin spend amount"
        },
        "raw_stop_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "liquidity_cap_sol": {
          "type": "number",
          "minimum": 0
        },
        "slippage_cap_sol": {
          "type": "number",
          "minimum": 0
        },
        "max_daily_loss_sol": {
          "type": "number",
          "minimum": 0
        },
        "max_position_size_sol": {
          "type": "number",
          "minimum": 0
        },
        "max_daily_entries": {
          "type": "number",
          "minimum": 1
        },
        "take_profit_pct": {
          "type": "number",
          "minimum": 0
        },
        "circuit_breaker_session_halt_sol": {
          "type": "number"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "default_route_mode",
        "default_slippage_bps",
        "default_priority_fee_sol",
        "route_promotion",
        "route_health"
      ],
      "additionalProperties": false,
      "properties": {
        "default_route_mode": {
          "type": "string",
          "enum": [
            "local",
            "lightning",
            "private",
            "jito"
          ]
        },
        "default_slippage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "default_priority_fee_sol": {
          "type": "number",
          "minimum": 0
        },
        "skip_preflight": {
          "type": "boolean",
          "default": false
        },
        "confirmation_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 30000
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "default": 2
        },
        "route_promotion": {
          "type": "object",
          "required": [
            "enabled",
            "opportunity_half_life_threshold_s",
            "min_edge_for_lightning",
            "min_edge_for_jito"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "opportunity_half_life_threshold_s": {
              "type": "number",
              "minimum": 0
            },
            "min_edge_for_lightning": {
              "type": "number",
              "minimum": 0
            },
            "min_edge_for_jito": {
              "type": "number",
              "minimum": 0
            },
            "demotion_cooldown_s": {
              "type": "number",
              "minimum": 0,
              "default": 60
            }
          }
        },
        "route_health": {
          "type": "object",
          "required": [
            "landing_latency_warn_ms",
            "landing_latency_fail_ms",
            "retry_rate_warn",
            "retry_rate_fail",
            "congestion_threshold",
            "freshness_max_s"
          ],
          "additionalProperties": false,
          "properties": {
            "landing_latency_warn_ms": {
              "type": "integer",
              "minimum": 0
            },
            "landing_latency_fail_ms": {
              "type": "integer",
              "minimum": 0
            },
            "retry_rate_warn": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "retry_rate_fail": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "congestion_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "freshness_max_s": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "private_route": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable Jito-protected private route"
            },
            "jito_block_engine_url": {
              "type": "string"
            },
            "jito_tip_lamports": {
              "type": "integer",
              "minimum": 0
            },
            "min_edge_for_private": {
              "type": "number",
              "minimum": 0
            },
            "max_tip_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "exit_slippage_trigger_pct": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Use private route for exits when slippage exceeds this"
            }
          }
        },
        "bundle_route": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Enable Jito bundle route (multi-tx atomic only)"
            },
            "max_bundle_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "min_edge_for_bundle": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "dynamic_priority_fee": {
          "type": "boolean"
        },
        "dynamic_priority_fee_percentile": {
          "type": "number",
          "minimum": 1,
          "maximum": 99
        },
        "priority_fee_floor_sol": {
          "type": "number",
          "minimum": 0
        },
        "priority_fee_cap_sol": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "fees": {
      "type": "object",
      "required": [
        "pump_fee_pct",
        "pump_swap_fee_pct",
        "pump_portal_fee_pct",
        "solana_base_fee_sol",
        "priority_fee_default_sol"
      ],
      "additionalProperties": false,
      "properties": {
        "pump_fee_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pump_swap_fee_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pump_portal_fee_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "solana_base_fee_sol": {
          "type": "number",
          "minimum": 0
        },
        "priority_fee_default_sol": {
          "type": "number",
          "minimum": 0
        },
        "regime_fee_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "pump_fee_pct": {
                "type": "number"
              },
              "pump_swap_fee_pct": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "llm": {
      "type": "object",
      "required": [
        "provider",
        "default_model"
      ],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "const": "anthropic"
        },
        "default_model": {
          "type": "string",
          "description": "Default model for all model-invoked tasks"
        },
        "escalation_model": {
          "type": "string",
          "description": "Model for hard supervisory tasks"
        },
        "escalation_task_classes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Task classes that use escalation_model"
        },
        "supervisory_thinking_budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "candidate_adjudication": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "medium"
            },
            "daily_analysis": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "high"
            },
            "operator_summary": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "low"
            },
            "weekly_review": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "high"
            },
            "complex_attribution": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "high"
            },
            "policy_improvement": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "default": "high"
            }
          }
        },
        "supervisory_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 15000
        }
      }
    },
    "corecast": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable CoreCast as primary fast-lane feed"
        },
        "endpoint": {
          "type": "string",
          "description": "CoreCast streaming endpoint URL"
        },
        "api_key_env": {
          "type": "string",
          "description": "Environment variable name for API key"
        },
        "subscribe_new_tokens": {
          "type": "boolean",
          "default": true
        },
        "subscribe_trades": {
          "type": "boolean",
          "default": true
        },
        "subscribe_migrations": {
          "type": "boolean",
          "default": true
        },
        "reconnect_base_ms": {
          "type": "integer",
          "minimum": 100,
          "default": 1000
        },
        "reconnect_max_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 30000
        },
        "stale_threshold_ms": {
          "type": "integer",
          "minimum": 1000,
          "default": 5000
        },
        "primary_for_market_data": {
          "type": "boolean",
          "default": true,
          "description": "When true, PumpPortal becomes fallback-only for market data"
        },
        "grpc_enabled": {
          "type": "boolean",
          "description": "Use gRPC streaming (v3) instead of HTTP polling (v2)"
        },
        "grpc_endpoint": {
          "type": "string",
          "description": "gRPC server endpoint (default: corecast.bitquery.io)"
        }
      }
    },
    "features": {
      "type": "object",
      "required": [
        "windows_s",
        "qualified_wallet_prior",
        "multimodal_junk_filter"
      ],
      "additionalProperties": false,
      "properties": {
        "windows_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "description": "Rolling feature windows in seconds"
        },

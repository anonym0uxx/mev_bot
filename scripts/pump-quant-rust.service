[Unit]
Description=pump-quant Rust MEV daemon
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=node
WorkingDirectory=/data/.openclaw/workspace/projects/pump-quant
EnvironmentFile=/data/.openclaw/workspace/projects/pump-quant/rust/.env
Environment=PAPER_MODE=true
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1
ExecStart=/data/.openclaw/workspace/projects/pump-quant/rust/target/release/pump-quant
Restart=always
RestartSec=3
StandardOutput=append:/data/.openclaw/workspace/projects/pump-quant/logs/rust-daemon.log
StandardError=append:/data/.openclaw/workspace/projects/pump-quant/logs/rust-daemon.log
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
